rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin"
        ) ||
        request.auth.token.email == "admin@filmaworkspace.com"
      );
    }

    function isSupportAgent() {
      return isSignedIn() &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "support_agent";
    }

    function hasProjectAccess(projectId) {
      return isSignedIn() &&
             exists(/databases/$(database)/documents/userProjects/$(request.auth.uid)/projects/$(projectId));
    }

    function isProjectMember(projectId) {
      return isSignedIn() &&
             exists(/databases/$(database)/documents/projects/$(projectId)/members/$(request.auth.uid));
    }

    function hasUserProjectPermission(projectId, permission) {
      let docPath = /databases/$(database)/documents/userProjects/$(request.auth.uid)/projects/$(projectId);
      return isSignedIn() &&
             exists(docPath) &&
             get(docPath).data.permissions != null &&
             get(docPath).data.permissions[permission] == true;
    }

    function hasMemberPermission(projectId, permission) {
      let docPath = /databases/$(database)/documents/projects/$(projectId)/members/$(request.auth.uid);
      return isSignedIn() &&
             exists(docPath) &&
             get(docPath).data.permissions != null &&
             get(docPath).data.permissions[permission] == true;
    }

    function canAddSelfAsMember(memberId) {
      return isSignedIn() && request.auth.uid == memberId;
    }

    function hasAccountingAccess(projectId) {
      let docPath = /databases/$(database)/documents/userProjects/$(request.auth.uid)/projects/$(projectId);
      return isSignedIn() &&
             exists(docPath) &&
             get(docPath).data.permissions != null &&
             get(docPath).data.permissions.accounting == true;
    }

    function hasAccountingExtendedAccess(projectId) {
      let docPath = /databases/$(database)/documents/projects/$(projectId)/members/$(request.auth.uid);
      return isSignedIn() &&
             exists(docPath) &&
             get(docPath).data.accountingAccessLevel == "accounting_extended";
    }

    function isEPorPM(projectId) {
      let docPath = /databases/$(database)/documents/projects/$(projectId)/members/$(request.auth.uid);
      return isSignedIn() &&
             exists(docPath) &&
             get(docPath).data.role in ["EP", "PM"];
    }

    function isApproverRole(projectId) {
      let docPath = /databases/$(database)/documents/projects/$(projectId)/members/$(request.auth.uid);
      return isSignedIn() &&
             exists(docPath) &&
             get(docPath).data.role in ["EP", "PM", "Controller", "PC"];
    }

    function hasTeamAccess(projectId) {
      return isSignedIn() && (
        hasUserProjectPermission(projectId, 'team') ||
        hasMemberPermission(projectId, 'team') ||
        isEPorPM(projectId) ||
        (
          exists(/databases/$(database)/documents/projects/$(projectId)/members/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/projects/$(projectId)/members/$(request.auth.uid)).data.role == "PC"
        )
      );
    }

    function getUserCompanyId() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId;
    }

    function hasCompanyProjectAccess(projectId) {
      let companyId = getUserCompanyId();
      return companyId != null &&
             exists(/databases/$(database)/documents/companyProjects/$(companyId)/projects/$(projectId));
    }

    function hasBudgetingAccess() {
      return isSignedIn() &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.budgetingAccess == true;
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();

      match /projects/{projectId} {
        allow read: if isSignedIn() && request.auth.uid == userId;
        allow create: if isSignedIn() && (request.auth.uid == userId || isAdmin());
        allow update: if isSignedIn() && (request.auth.uid == userId || isAdmin());
        allow delete: if isAdmin();
      }

      match /messages/{messageId} {
        allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
        allow create: if isAdmin();
        allow update: if isSignedIn() && request.auth.uid == userId;
        allow delete: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      }
    }

    match /projects/{projectId} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        hasProjectAccess(projectId) ||
        isProjectMember(projectId) ||
        hasCompanyProjectAccess(projectId)
      );
      allow create: if isAdmin();
      allow update: if isAdmin() ||
                       hasUserProjectPermission(projectId, 'config') ||
                       hasMemberPermission(projectId, 'config');
      allow delete: if isAdmin();

      match /members/{memberId} {
        allow read: if isSignedIn() && (
          isAdmin() ||
          hasProjectAccess(projectId) ||
          isProjectMember(projectId) ||
          hasCompanyProjectAccess(projectId)
        );
        allow create: if isAdmin() ||
                         hasUserProjectPermission(projectId, 'config') ||
                         hasMemberPermission(projectId, 'config') ||
                         hasUserProjectPermission(projectId, 'team') ||
                         hasMemberPermission(projectId, 'team') ||
                         canAddSelfAsMember(memberId);
        allow update, delete: if isAdmin() ||
                                  hasUserProjectPermission(projectId, 'config') ||
                                  hasMemberPermission(projectId, 'config') ||
                                  hasUserProjectPermission(projectId, 'team') ||
                                  hasMemberPermission(projectId, 'team') ||
                                  hasAccountingExtendedAccess(projectId);
      }

      match /departments/{departmentId} {
        allow read: if isSignedIn() && (
          isAdmin() ||
          hasProjectAccess(projectId) ||
          isProjectMember(projectId) ||
          hasCompanyProjectAccess(projectId)
        );
        allow write: if isAdmin() ||
                        hasUserProjectPermission(projectId, 'config') ||
                        hasMemberPermission(projectId, 'config');
      }

      match /config/{configId} {
        allow read: if isSignedIn() && (
          isAdmin() ||
          hasProjectAccess(projectId) ||
          isProjectMember(projectId) ||
          hasCompanyProjectAccess(projectId)
        );
        allow write: if isAdmin() ||
                        isEPorPM(projectId) ||
                        hasAccountingExtendedAccess(projectId) ||
                        hasUserProjectPermission(projectId, 'config');

        match /{subCollection}/{docId} {
          allow read: if isSignedIn() && (
            isAdmin() ||
            hasProjectAccess(projectId) ||
            isProjectMember(projectId) ||
            hasCompanyProjectAccess(projectId)
          );
          allow write: if isAdmin() ||
                          isEPorPM(projectId) ||
                          hasAccountingExtendedAccess(projectId) ||
                          hasUserProjectPermission(projectId, 'config');
        }
      }

      match /accounts/{accountId} {
        allow read: if isSignedIn() && (
          isAdmin() ||
          hasAccountingAccess(projectId) ||
          hasProjectAccess(projectId) ||
          isProjectMember(projectId) ||
          hasCompanyProjectAccess(projectId)
        );
        allow create, update, delete: if isAdmin() ||
                                         hasAccountingAccess(projectId) ||
                                         isEPorPM(projectId);

        match /subaccounts/{subId} {
          allow read: if isSignedIn() && (
            isAdmin() ||
            hasAccountingAccess(projectId) ||
            hasProjectAccess(projectId) ||
            isProjectMember(projectId) ||
            hasCompanyProjectAccess(projectId)
          );
          allow create, update, delete: if isAdmin() ||
                                           hasAccountingAccess(projectId) ||
                                           isEPorPM(projectId);
        }
      }

      match /suppliers/{supplierId} {
        allow read: if isSignedIn() && (
          isAdmin() ||
          hasAccountingAccess(projectId) ||
          hasProjectAccess(projectId) ||
          isProjectMember(projectId) ||
          hasCompanyProjectAccess(projectId)
        );
        allow create, update: if isAdmin() ||
                                  hasAccountingAccess(projectId) ||
                                  isEPorPM(projectId);
        allow delete: if isAdmin() ||
                         isEPorPM(projectId) ||
                         hasAccountingExtendedAccess(projectId);
      }

      match /pos/{poId} {
        allow read: if isSignedIn() && (
          isAdmin() ||
          hasAccountingAccess(projectId) ||
          hasProjectAccess(projectId) ||
          isProjectMember(projectId) ||
          hasCompanyProjectAccess(projectId)
        );
        allow create: if isAdmin() ||
                         hasAccountingAccess(projectId) ||
                         isProjectMember(projectId);
        allow update: if isAdmin() ||
                         hasAccountingAccess(projectId) ||
                         isApproverRole(projectId);
        allow delete: if isAdmin() || isEPorPM(projectId);
      }

      match /invoices/{invoiceId} {
        allow read: if isSignedIn() && (
          isAdmin() ||
          hasAccountingAccess(projectId) ||
          hasProjectAccess(projectId) ||
          isProjectMember(projectId) ||
          hasCompanyProjectAccess(projectId)
        );
        allow create: if isAdmin() ||
                         hasAccountingAccess(projectId) ||
                         isProjectMember(projectId);
        allow update: if isAdmin() ||
                         hasAccountingAccess(projectId) ||
                         isApproverRole(projectId) ||
                         hasCompanyProjectAccess(projectId);
        allow delete: if isAdmin() || isEPorPM(projectId);
      }

      match /payments/{paymentId} {
        allow read: if isSignedIn() && (
          isAdmin() ||
          hasAccountingAccess(projectId) ||
          isEPorPM(projectId) ||
          hasCompanyProjectAccess(projectId)
        );
        allow write: if isAdmin() ||
                        isEPorPM(projectId) ||
                        hasAccountingExtendedAccess(projectId);
      }

      match /paymentForecasts/{forecastId} {
        allow read: if isSignedIn() && (
          isAdmin() ||
          hasAccountingAccess(projectId) ||
          isEPorPM(projectId) ||
          hasCompanyProjectAccess(projectId)
        );
        allow create, update: if isAdmin() ||
                                  hasAccountingAccess(projectId) ||
                                  isEPorPM(projectId);
        allow delete: if isAdmin() ||
                         isEPorPM(projectId) ||
                         hasAccountingExtendedAccess(projectId);
      }

      match /manualEntries/{entryId} {
        allow read: if isSignedIn() && (
          isAdmin() ||
          hasAccountingAccess(projectId) ||
          hasCompanyProjectAccess(projectId)
        );
        allow write: if isAdmin() ||
                        hasCompanyProjectAccess(projectId) ||
                        hasAccountingExtendedAccess(projectId);
      }

      match /cards/{boxId} {
        allow read: if isSignedIn() && (
          isAdmin() ||
          hasAccountingAccess(projectId) ||
          hasProjectAccess(projectId) ||
          isProjectMember(projectId) ||
          hasCompanyProjectAccess(projectId)
        );
        allow create, update: if isAdmin() ||
                                  hasAccountingAccess(projectId) ||
                                  isEPorPM(projectId);
        allow delete: if isAdmin() ||
                         isEPorPM(projectId) ||
                         hasAccountingExtendedAccess(projectId);
      }

      match /cardEnvelopes/{envelopeId} {
        allow read: if isSignedIn() && (
          isAdmin() ||
          hasAccountingAccess(projectId) ||
          hasProjectAccess(projectId) ||
          isProjectMember(projectId) ||
          hasCompanyProjectAccess(projectId)
        );
        allow create, update: if isAdmin() ||
                                  hasAccountingAccess(projectId) ||
                                  isApproverRole(projectId);
        allow delete: if isAdmin() ||
                         isEPorPM(projectId) ||
                         hasAccountingExtendedAccess(projectId);
      }

      match /cardExpenses/{expenseId} {
        allow read: if isSignedIn() && (
          isAdmin() ||
          hasAccountingAccess(projectId) ||
          hasProjectAccess(projectId) ||
          isProjectMember(projectId) ||
          hasCompanyProjectAccess(projectId)
        );
        allow create, update: if isAdmin() ||
                                  hasAccountingAccess(projectId) ||
                                  isApproverRole(projectId);
        allow delete: if isAdmin() ||
                         isEPorPM(projectId) ||
                         hasAccountingExtendedAccess(projectId);
      }

      match /cardSuppliers/{supplierId} {
        allow read: if isSignedIn() && (
          isAdmin() ||
          hasAccountingAccess(projectId) ||
          hasProjectAccess(projectId) ||
          isProjectMember(projectId) ||
          hasCompanyProjectAccess(projectId)
        );
        allow create, update: if isAdmin() ||
                                  hasAccountingAccess(projectId) ||
                                  isEPorPM(projectId);
        allow delete: if isAdmin() ||
                         isEPorPM(projectId) ||
                         hasAccountingExtendedAccess(projectId);
      }

      match /transferEnvelopes/{envelopeId} {
        allow read: if isSignedIn() && (
          isAdmin() ||
          hasAccountingAccess(projectId) ||
          hasProjectAccess(projectId) ||
          isProjectMember(projectId) ||
          hasCompanyProjectAccess(projectId)
        );
        allow create, update: if isAdmin() ||
                                  hasAccountingAccess(projectId) ||
                                  isApproverRole(projectId);
        allow delete: if isAdmin() ||
                         isEPorPM(projectId) ||
                         hasAccountingExtendedAccess(projectId);
      }

      match /transferExpenses/{expenseId} {
        allow read: if isSignedIn() && (
          isAdmin() ||
          hasAccountingAccess(projectId) ||
          hasProjectAccess(projectId) ||
          isProjectMember(projectId) ||
          hasCompanyProjectAccess(projectId)
        );
        allow create, update: if isAdmin() ||
                                  hasAccountingAccess(projectId) ||
                                  isApproverRole(projectId);
        allow delete: if isAdmin() ||
                         isEPorPM(projectId) ||
                         hasAccountingExtendedAccess(projectId);
      }

      match /crew/{crewId} {
        allow read: if isSignedIn() && (
          isAdmin() ||
          hasTeamAccess(projectId) ||
          hasProjectAccess(projectId)
        );
        allow create, update: if isAdmin() ||
                                  hasTeamAccess(projectId);
        allow delete: if isAdmin() ||
                         hasTeamAccess(projectId);
      }

      match /teamConfig/{docId} {
        allow read: if isSignedIn() && (
          isAdmin() ||
          hasTeamAccess(projectId) ||
          hasProjectAccess(projectId)
        );
        allow write: if isAdmin() ||
                        hasTeamAccess(projectId) ||
                        isEPorPM(projectId);
      }

      match /payrollMonths/{monthId} {
        allow read: if (isSignedIn() && (
                        isAdmin() ||
                        hasTeamAccess(projectId) ||
                        hasProjectAccess(projectId)
                      )) ||
                      request.auth == null;

        allow write: if (isSignedIn() && (
                        isAdmin() ||
                        hasTeamAccess(projectId)
                      )) ||
                      (
                        request.auth == null &&
                        'accessCode' in request.resource.data &&
                        get(/databases/$(database)/documents/access/$(request.resource.data.accessCode)).data.active == true &&
                        get(/databases/$(database)/documents/access/$(request.resource.data.accessCode)).data.projectId == projectId
                      );
      }

      match /dietasForms/{formId} {
        allow read: if isSignedIn() && (
          isAdmin() ||
          hasTeamAccess(projectId) ||
          hasProjectAccess(projectId)
        );
        allow write: if isAdmin() ||
                        hasTeamAccess(projectId);
      }

      match /horario/{docId} {
        allow read: if isSignedIn() && (
          isAdmin() ||
          hasTeamAccess(projectId) ||
          hasProjectAccess(projectId)
        );
        allow write: if isAdmin() || hasTeamAccess(projectId);
      }

      match /horarioForms/{formId} {
        allow read: if isSignedIn() && (
          isAdmin() ||
          hasTeamAccess(projectId) ||
          hasProjectAccess(projectId)
        );
        allow create: if isSignedIn();
        allow update: if true;
        allow delete: if isAdmin();
      }

      match /horarioGroups/{groupId} {
        allow read: if isSignedIn() && (
          isAdmin() ||
          hasTeamAccess(projectId) ||
          hasProjectAccess(projectId)
        );
        allow write: if isAdmin() || hasTeamAccess(projectId);
      }

      match /logs/{logId} {
        allow read: if isAdmin();
        allow create: if isSignedIn();
        allow update, delete: if isAdmin();
      }
    }

    match /userProjects/{userId}/projects/{projectId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow write: if isSignedIn() && (
        request.auth.uid == userId ||
        isAdmin() ||
        hasUserProjectPermission(projectId, 'config') ||
        hasMemberPermission(projectId, 'config') ||
        hasAccountingExtendedAccess(projectId)
      );
    }

    match /companyProjects/{companyId}/projects/{projectId} {
      allow read: if isSignedIn() && (isAdmin() || getUserCompanyId() == companyId);
      allow write: if isAdmin();
    }

    // ── Budgeting: entorno independiente de proyecto, presupuestos de cero ──
    match /budgetingDrafts/{draftId} {
      allow read, update, delete: if isSignedIn() && (
        isAdmin() ||
        (hasBudgetingAccess() && resource.data.ownerUid == request.auth.uid)
      );
      allow create: if isSignedIn() && hasBudgetingAccess() &&
                       request.resource.data.ownerUid == request.auth.uid;

      match /accounts/{accountId} {
        allow read, write: if isSignedIn() && (
          isAdmin() ||
          (hasBudgetingAccess() &&
           get(/databases/$(database)/documents/budgetingDrafts/$(draftId)).data.ownerUid == request.auth.uid)
        );

        match /subchapters/{subchapterId} {
          allow read, write: if isSignedIn() && (
            isAdmin() ||
            (hasBudgetingAccess() &&
             get(/databases/$(database)/documents/budgetingDrafts/$(draftId)).data.ownerUid == request.auth.uid)
          );

          match /detailLines/{lineId} {
            allow read, write: if isSignedIn() && (
              isAdmin() ||
              (hasBudgetingAccess() &&
               get(/databases/$(database)/documents/budgetingDrafts/$(draftId)).data.ownerUid == request.auth.uid)
            );
          }
        }
      }

      match /snapshots/{snapshotId} {
        allow read, write: if isSignedIn() && (
          isAdmin() ||
          (hasBudgetingAccess() &&
           get(/databases/$(database)/documents/budgetingDrafts/$(draftId)).data.ownerUid == request.auth.uid)
        );
      }
    }

    match /userBudgetingDrafts/{userId}/drafts/{draftId} {
      allow read, write: if isSignedIn() && (request.auth.uid == userId || isAdmin());
    }

    match /producers/{producerId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /invitations/{invitationId} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        resource.data.invitedUserId == request.auth.uid ||
        resource.data.invitedEmail == request.auth.token.email ||
        hasProjectAccess(resource.data.projectId)
      );
      allow create: if isSignedIn() && (
        isAdmin() ||
        hasProjectAccess(request.resource.data.projectId) ||
        hasUserProjectPermission(request.resource.data.projectId, 'config') ||
        hasMemberPermission(request.resource.data.projectId, 'config') ||
        hasAccountingExtendedAccess(request.resource.data.projectId) ||
        isEPorPM(request.resource.data.projectId)
      );
      allow update: if isSignedIn() && (
        isAdmin() ||
        resource.data.invitedUserId == request.auth.uid ||
        resource.data.invitedEmail == request.auth.token.email ||
        hasProjectAccess(resource.data.projectId)
      );
      allow delete: if isAdmin() || hasProjectAccess(resource.data.projectId);
    }

    match /departments/{departmentId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /forms/{formId} {
      allow read: if true;

      allow create: if isSignedIn() && (
        isAdmin() ||
        hasTeamAccess(request.resource.data.projectId) ||
        hasProjectAccess(request.resource.data.projectId)
      );

      allow update: if (
        resource.data.status == "pending" &&
        request.resource.data.status == "submitted"
      ) || isAdmin() || (
        isSignedIn() && (
          hasTeamAccess(resource.data.projectId) ||
          hasProjectAccess(resource.data.projectId)
        )
      );

      allow delete: if isAdmin();
    }

    match /access/{code} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    match /supportChats/{userId} {
      allow read, write: if isSignedIn() && (request.auth.uid == userId || isAdmin() || isSupportAgent());

      match /messages/{msgId} {
        allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin() || isSupportAgent());
        allow create: if isSignedIn() && (request.auth.uid == userId || isAdmin() || isSupportAgent());
        allow update, delete: if isAdmin();
      }
    }

    match /horarioForms/{formId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if true;
      allow delete: if isAdmin();
    }

    match /horarioAccess/{code} {
      allow read: if true;
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    match /meta/{docId} {
      allow read: if true;
      // automatedMessages y maintenance tienen su propia regla más abajo;
      // el resto de docs de meta (ej. supportTicketCounter) los puede tocar
      // cualquier usuario autenticado, incluidos anónimos.
      allow write: if isSignedIn() && docId != "automatedMessages" && docId != "maintenance";
    }

    match /meta/automatedMessages {
      allow read: if true;
      allow write: if isAdmin() || isSupportAgent();
    }

    match /meta/maintenance {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /guides/{guideId} {
      // Públicas si están publicadas (para el link que Soporte comparte);
      // admins y agentes de soporte ven también los borradores.
      allow read: if resource.data.published == true || isAdmin() || isSupportAgent();
      // Admins y agentes de soporte/ventas pueden crear y editar guías;
      // eliminarlas queda restringido a admins.
      allow create: if isAdmin() || isSupportAgent();
      allow delete: if isAdmin();
      // Cualquiera puede incrementar "views" en una guía publicada (contador
      // de visitas de la página pública); cualquier otro cambio requiere
      // admin o agente.
      allow update: if isAdmin() || isSupportAgent() || (
        resource.data.published == true &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views'])
      );
    }

  }
}
