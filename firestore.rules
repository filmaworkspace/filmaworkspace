rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin"
        ) ||
        request.auth.token.email == "admin@filmaworkspace.com"
      );
    }

    function isSupportAgent() {
      return isSignedIn() &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "support_agent";
    }

    function hasProjectAccess(projectId) {
      return isSignedIn() &&
             exists(/databases/$(database)/documents/userProjects/$(request.auth.uid)/projects/$(projectId));
    }

    function isProjectMember(projectId) {
      return isSignedIn() &&
             exists(/databases/$(database)/documents/projects/$(projectId)/members/$(request.auth.uid));
    }

    function hasUserProjectPermission(projectId, permission) {
      let docPath = /databases/$(database)/documents/userProjects/$(request.auth.uid)/projects/$(projectId);
      return isSignedIn() &&
             exists(docPath) &&
             get(docPath).data.permissions != null &&
             get(docPath).data.permissions[permission] == true;
    }

    function hasMemberPermission(projectId, permission) {
      let docPath = /databases/$(database)/documents/projects/$(projectId)/members/$(request.auth.uid);
      return isSignedIn() &&
             exists(docPath) &&
             get(docPath).data.permissions != null &&
             get(docPath).data.permissions[permission] == true;
    }


    function hasAccountingAccess(projectId) {
      let docPath = /databases/$(database)/documents/userProjects/$(request.auth.uid)/projects/$(projectId);
      return isSignedIn() &&
             exists(docPath) &&
             get(docPath).data.permissions != null &&
             get(docPath).data.permissions.accounting == true;
    }

    function hasAccountingExtendedAccess(projectId) {
      let docPath = /databases/$(database)/documents/projects/$(projectId)/members/$(request.auth.uid);
      return isSignedIn() &&
             exists(docPath) &&
             get(docPath).data.accountingAccessLevel == "accounting_extended";
    }

    function isEPorPM(projectId) {
      let docPath = /databases/$(database)/documents/projects/$(projectId)/members/$(request.auth.uid);
      return isSignedIn() &&
             exists(docPath) &&
             get(docPath).data.role in ["EP", "PM"];
    }

    function isApproverRole(projectId) {
      let docPath = /databases/$(database)/documents/projects/$(projectId)/members/$(request.auth.uid);
      return isSignedIn() &&
             exists(docPath) &&
             get(docPath).data.role in ["EP", "PM", "Controller", "PC"];
    }

    function hasTeamAccess(projectId) {
      return isSignedIn() && (
        hasUserProjectPermission(projectId, 'team') ||
        hasMemberPermission(projectId, 'team') ||
        isEPorPM(projectId) ||
        (
          exists(/databases/$(database)/documents/projects/$(projectId)/members/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/projects/$(projectId)/members/$(request.auth.uid)).data.role == "PC"
        )
      );
    }

    function getUserCompanyId() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId;
    }

    function hasCompanyProjectAccess(projectId) {
      let companyId = getUserCompanyId();
      return companyId != null &&
             exists(/databases/$(database)/documents/companyProjects/$(companyId)/projects/$(projectId));
    }

    // Campos de users/{uid} que solo puede tocar un admin (o el servidor):
    // si el propio usuario pudiera escribirlos, podría hacerse admin, entrar
    // en una productora o darse acceso a Budgeting.
    function protectedUserFields() {
      return ["role", "companyId", "budgetingAccess", "supportSpecialty"];
    }

    // Lo único que puede escribir quien rellena un horario desde su enlace.
    function isHorarioSubmission() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(["entrada", "salida", "comida", "observaciones", "submittedAt"]);
    }

    function isSupportChatEnabled() {
      let ref = /databases/$(database)/documents/meta/supportChat;
      return !exists(ref) || get(ref).data.get("enabled", true) != false;
    }

    function hasBudgetingAccess() {
      return isSignedIn() &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.budgetingAccess == true;
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      // Al registrarse, el usuario crea su propio doc siempre como "user" y
      // sin campos protegidos.
      allow create: if isAdmin() || (
        isSignedIn() && request.auth.uid == userId &&
        request.resource.data.get("role", "user") == "user" &&
        !request.resource.data.keys().hasAny(["companyId", "budgetingAccess", "supportSpecialty"])
      );
      // El propio usuario puede editar su perfil, pero no los campos protegidos.
      allow update: if isAdmin() || (
        isSignedIn() && request.auth.uid == userId &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(protectedUserFields())
      );
      allow delete: if isAdmin();

      match /projects/{projectId} {
        allow read: if isSignedIn() && request.auth.uid == userId;
        allow create, update: if isAdmin();
        allow delete: if isAdmin();
      }

      match /messages/{messageId} {
        allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
        allow create: if isAdmin();
        allow update: if isSignedIn() && request.auth.uid == userId;
        allow delete: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      }
    }

    match /projects/{projectId} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        hasProjectAccess(projectId) ||
        isProjectMember(projectId) ||
        hasCompanyProjectAccess(projectId)
      );
      allow create: if isAdmin();
      allow update: if isAdmin() ||
                       hasUserProjectPermission(projectId, 'config') ||
                       hasMemberPermission(projectId, 'config');
      allow delete: if isAdmin();

      match /members/{memberId} {
        allow read: if isSignedIn() && (
          isAdmin() ||
          hasProjectAccess(projectId) ||
          isProjectMember(projectId) ||
          hasCompanyProjectAccess(projectId)
        );
        allow create: if isAdmin() ||
                         hasUserProjectPermission(projectId, 'config') ||
                         hasMemberPermission(projectId, 'config') ||
                         hasUserProjectPermission(projectId, 'team') ||
                         hasMemberPermission(projectId, 'team');
        // Aceptar una invitación lo hace el servidor (/api/accept-invitation):
        // un usuario no puede añadirse a sí mismo a un proyecto.
        allow update, delete: if isAdmin() ||
                                  hasUserProjectPermission(projectId, 'config') ||
                                  hasMemberPermission(projectId, 'config') ||
                                  hasUserProjectPermission(projectId, 'team') ||
                                  hasMemberPermission(projectId, 'team') ||
                                  hasAccountingExtendedAccess(projectId);
      }

      match /departments/{departmentId} {
        allow read: if isSignedIn() && (
          isAdmin() ||
          hasProjectAccess(projectId) ||
          isProjectMember(projectId) ||
          hasCompanyProjectAccess(projectId)
        );
        allow write: if isAdmin() ||
                        hasUserProjectPermission(projectId, 'config') ||
                        hasMemberPermission(projectId, 'config');
      }

      match /config/{configId} {
        allow read: if isSignedIn() && (
          isAdmin() ||
          hasProjectAccess(projectId) ||
          isProjectMember(projectId) ||
          hasCompanyProjectAccess(projectId)
        );
        allow write: if isAdmin() ||
                        isEPorPM(projectId) ||
                        hasAccountingExtendedAccess(projectId) ||
                        hasUserProjectPermission(projectId, 'config');

        match /{subCollection}/{docId} {
          allow read: if isSignedIn() && (
            isAdmin() ||
            hasProjectAccess(projectId) ||
            isProjectMember(projectId) ||
            hasCompanyProjectAccess(projectId)
          );
          allow write: if isAdmin() ||
                          isEPorPM(projectId) ||
                          hasAccountingExtendedAccess(projectId) ||
                          hasUserProjectPermission(projectId, 'config');
        }
      }

      match /accounts/{accountId} {
        allow read: if isSignedIn() && (
          isAdmin() ||
          hasAccountingAccess(projectId) ||
          hasProjectAccess(projectId) ||
          isProjectMember(projectId) ||
          hasCompanyProjectAccess(projectId)
        );
        allow create, update, delete: if isAdmin() ||
                                         hasAccountingAccess(projectId) ||
                                         isEPorPM(projectId);

        match /subaccounts/{subId} {
          allow read: if isSignedIn() && (
            isAdmin() ||
            hasAccountingAccess(projectId) ||
            hasProjectAccess(projectId) ||
            isProjectMember(projectId) ||
            hasCompanyProjectAccess(projectId)
          );
          allow create, update, delete: if isAdmin() ||
                                           hasAccountingAccess(projectId) ||
                                           isEPorPM(projectId);
        }
      }

      match /suppliers/{supplierId} {
        allow read: if isSignedIn() && (
          isAdmin() ||
          hasAccountingAccess(projectId) ||
          hasProjectAccess(projectId) ||
          isProjectMember(projectId) ||
          hasCompanyProjectAccess(projectId)
        );
        allow create, update: if isAdmin() ||
                                  hasAccountingAccess(projectId) ||
                                  isEPorPM(projectId);
        allow delete: if isAdmin() ||
                         isEPorPM(projectId) ||
                         hasAccountingExtendedAccess(projectId);
      }

      match /pos/{poId} {
        allow read: if isSignedIn() && (
          isAdmin() ||
          hasAccountingAccess(projectId) ||
          hasProjectAccess(projectId) ||
          isProjectMember(projectId) ||
          hasCompanyProjectAccess(projectId)
        );
        allow create: if isAdmin() ||
                         hasAccountingAccess(projectId) ||
                         isProjectMember(projectId);
        allow update: if isAdmin() ||
                         hasAccountingAccess(projectId) ||
                         isApproverRole(projectId);
        allow delete: if isAdmin() || isEPorPM(projectId);
      }

      match /invoices/{invoiceId} {
        allow read: if isSignedIn() && (
          isAdmin() ||
          hasAccountingAccess(projectId) ||
          hasProjectAccess(projectId) ||
          isProjectMember(projectId) ||
          hasCompanyProjectAccess(projectId)
        );
        allow create: if isAdmin() ||
                         hasAccountingAccess(projectId) ||
                         isProjectMember(projectId);
        allow update: if isAdmin() ||
                         hasAccountingAccess(projectId) ||
                         isApproverRole(projectId) ||
                         hasCompanyProjectAccess(projectId);
        allow delete: if isAdmin() || isEPorPM(projectId);
      }

      match /payments/{paymentId} {
        allow read: if isSignedIn() && (
          isAdmin() ||
          hasAccountingAccess(projectId) ||
          isEPorPM(projectId) ||
          hasCompanyProjectAccess(projectId)
        );
        allow write: if isAdmin() ||
                        isEPorPM(projectId) ||
                        hasAccountingExtendedAccess(projectId);
      }

      match /paymentForecasts/{forecastId} {
        allow read: if isSignedIn() && (
          isAdmin() ||
          hasAccountingAccess(projectId) ||
          isEPorPM(projectId) ||
          hasCompanyProjectAccess(projectId)
        );
        allow create, update: if isAdmin() ||
                                  hasAccountingAccess(projectId) ||
                                  isEPorPM(projectId);
        allow delete: if isAdmin() ||
                         isEPorPM(projectId) ||
                         hasAccountingExtendedAccess(projectId);
      }

      match /manualEntries/{entryId} {
        allow read: if isSignedIn() && (
          isAdmin() ||
          hasAccountingAccess(projectId) ||
          hasCompanyProjectAccess(projectId)
        );
        allow write: if isAdmin() ||
                        hasCompanyProjectAccess(projectId) ||
                        hasAccountingExtendedAccess(projectId);
      }

      match /cards/{boxId} {
        allow read: if isSignedIn() && (
          isAdmin() ||
          hasAccountingAccess(projectId) ||
          hasProjectAccess(projectId) ||
          isProjectMember(projectId) ||
          hasCompanyProjectAccess(projectId)
        );
        allow create, update: if isAdmin() ||
                                  hasAccountingAccess(projectId) ||
                                  isEPorPM(projectId);
        allow delete: if isAdmin() ||
                         isEPorPM(projectId) ||
                         hasAccountingExtendedAccess(projectId);
      }

      match /cardEnvelopes/{envelopeId} {
        allow read: if isSignedIn() && (
          isAdmin() ||
          hasAccountingAccess(projectId) ||
          hasProjectAccess(projectId) ||
          isProjectMember(projectId) ||
          hasCompanyProjectAccess(projectId)
        );
        allow create, update: if isAdmin() ||
                                  hasAccountingAccess(projectId) ||
                                  isApproverRole(projectId);
        allow delete: if isAdmin() ||
                         isEPorPM(projectId) ||
                         hasAccountingExtendedAccess(projectId);
      }

      match /cardExpenses/{expenseId} {
        allow read: if isSignedIn() && (
          isAdmin() ||
          hasAccountingAccess(projectId) ||
          hasProjectAccess(projectId) ||
          isProjectMember(projectId) ||
          hasCompanyProjectAccess(projectId)
        );
        allow create, update: if isAdmin() ||
                                  hasAccountingAccess(projectId) ||
                                  isApproverRole(projectId);
        allow delete: if isAdmin() ||
                         isEPorPM(projectId) ||
                         hasAccountingExtendedAccess(projectId);
      }

      match /cardSuppliers/{supplierId} {
        allow read: if isSignedIn() && (
          isAdmin() ||
          hasAccountingAccess(projectId) ||
          hasProjectAccess(projectId) ||
          isProjectMember(projectId) ||
          hasCompanyProjectAccess(projectId)
        );
        allow create, update: if isAdmin() ||
                                  hasAccountingAccess(projectId) ||
                                  isEPorPM(projectId);
        allow delete: if isAdmin() ||
                         isEPorPM(projectId) ||
                         hasAccountingExtendedAccess(projectId);
      }

      match /transferEnvelopes/{envelopeId} {
        allow read: if isSignedIn() && (
          isAdmin() ||
          hasAccountingAccess(projectId) ||
          hasProjectAccess(projectId) ||
          isProjectMember(projectId) ||
          hasCompanyProjectAccess(projectId)
        );
        allow create, update: if isAdmin() ||
                                  hasAccountingAccess(projectId) ||
                                  isApproverRole(projectId);
        allow delete: if isAdmin() ||
                         isEPorPM(projectId) ||
                         hasAccountingExtendedAccess(projectId);
      }

      match /transferExpenses/{expenseId} {
        allow read: if isSignedIn() && (
          isAdmin() ||
          hasAccountingAccess(projectId) ||
          hasProjectAccess(projectId) ||
          isProjectMember(projectId) ||
          hasCompanyProjectAccess(projectId)
        );
        allow create, update: if isAdmin() ||
                                  hasAccountingAccess(projectId) ||
                                  isApproverRole(projectId);
        allow delete: if isAdmin() ||
                         isEPorPM(projectId) ||
                         hasAccountingExtendedAccess(projectId);
      }

      match /crew/{crewId} {
        allow read: if isSignedIn() && (
          isAdmin() ||
          hasTeamAccess(projectId) ||
          hasProjectAccess(projectId)
        );
        allow create, update: if isAdmin() ||
                                  hasTeamAccess(projectId);
        allow delete: if isAdmin() ||
                         hasTeamAccess(projectId);
      }

      match /teamConfig/{docId} {
        allow read: if isSignedIn() && (
          isAdmin() ||
          hasTeamAccess(projectId) ||
          hasProjectAccess(projectId)
        );
        allow write: if isAdmin() ||
                        hasTeamAccess(projectId) ||
                        isEPorPM(projectId);
      }

      match /payrollMonths/{monthId} {
        allow read: if isSignedIn() && (
                        isAdmin() ||
                        hasTeamAccess(projectId) ||
                        hasProjectAccess(projectId)
                      );
        // La página pública /access/[code] lee el mes por id. No se puede
        // listar sin sesión.
        allow get: if request.auth == null;

        allow write: if (isSignedIn() && (
                        isAdmin() ||
                        hasTeamAccess(projectId)
                      )) ||
                      (
                        request.auth == null &&
                        'accessCode' in request.resource.data &&
                        get(/databases/$(database)/documents/access/$(request.resource.data.accessCode)).data.active == true &&
                        get(/databases/$(database)/documents/access/$(request.resource.data.accessCode)).data.projectId == projectId
                      );
      }

      match /dietasForms/{formId} {
        allow read: if isSignedIn() && (
          isAdmin() ||
          hasTeamAccess(projectId) ||
          hasProjectAccess(projectId)
        );
        allow write: if isAdmin() ||
                        hasTeamAccess(projectId);
      }

      match /horario/{docId} {
        allow read: if isSignedIn() && (
          isAdmin() ||
          hasTeamAccess(projectId) ||
          hasProjectAccess(projectId)
        );
        allow write: if isAdmin() || hasTeamAccess(projectId);
      }

      match /horarioForms/{formId} {
        allow read: if isSignedIn() && (
          isAdmin() ||
          hasTeamAccess(projectId) ||
          hasProjectAccess(projectId)
        );
        allow create: if isAdmin() || hasTeamAccess(projectId);
        allow update: if isAdmin() || hasTeamAccess(projectId) || isHorarioSubmission();
        allow delete: if isAdmin();
      }

      match /horarioGroups/{groupId} {
        allow read: if isSignedIn() && (
          isAdmin() ||
          hasTeamAccess(projectId) ||
          hasProjectAccess(projectId)
        );
        allow write: if isAdmin() || hasTeamAccess(projectId);
      }

      match /logs/{logId} {
        allow read: if isAdmin();
        allow create: if isSignedIn();
        allow update, delete: if isAdmin();
      }
    }

    match /userProjects/{userId}/projects/{projectId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      // Quien gestiona el proyecto puede dar, cambiar y quitar accesos.
      allow write: if isSignedIn() && (
        isAdmin() ||
        hasUserProjectPermission(projectId, 'config') ||
        hasMemberPermission(projectId, 'config') ||
        hasAccountingExtendedAccess(projectId)
      );
      // El propio usuario solo puede cambiar sus preferencias (archivar,
      // favorito, notificaciones), nunca sus permisos ni darse de alta.
      allow update: if isSignedIn() && request.auth.uid == userId &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["archived", "favorite", "notifications"]);
    }

    match /companyProjects/{companyId}/projects/{projectId} {
      allow read: if isSignedIn() && (isAdmin() || getUserCompanyId() == companyId);
      allow write: if isAdmin();
    }

    // ── Budgeting: entorno independiente de proyecto, presupuestos de cero ──
    match /budgetingDrafts/{draftId} {
      allow read, update, delete: if isSignedIn() && (
        isAdmin() ||
        (hasBudgetingAccess() && resource.data.ownerUid == request.auth.uid)
      );
      allow create: if isSignedIn() && hasBudgetingAccess() &&
                       request.resource.data.ownerUid == request.auth.uid;

      match /accounts/{accountId} {
        allow read, write: if isSignedIn() && (
          isAdmin() ||
          (hasBudgetingAccess() &&
           get(/databases/$(database)/documents/budgetingDrafts/$(draftId)).data.ownerUid == request.auth.uid)
        );

        match /subchapters/{subchapterId} {
          allow read, write: if isSignedIn() && (
            isAdmin() ||
            (hasBudgetingAccess() &&
             get(/databases/$(database)/documents/budgetingDrafts/$(draftId)).data.ownerUid == request.auth.uid)
          );

          match /detailLines/{lineId} {
            allow read, write: if isSignedIn() && (
              isAdmin() ||
              (hasBudgetingAccess() &&
               get(/databases/$(database)/documents/budgetingDrafts/$(draftId)).data.ownerUid == request.auth.uid)
            );
          }
        }
      }

      match /snapshots/{snapshotId} {
        allow read, write: if isSignedIn() && (
          isAdmin() ||
          (hasBudgetingAccess() &&
           get(/databases/$(database)/documents/budgetingDrafts/$(draftId)).data.ownerUid == request.auth.uid)
        );
      }
    }

    match /userBudgetingDrafts/{userId}/drafts/{draftId} {
      allow read, write: if isSignedIn() && (request.auth.uid == userId || isAdmin());
    }

    match /userBudgetingTemplates/{userId}/templates/{templateId} {
      allow read, write: if isSignedIn() && (request.auth.uid == userId || isAdmin());
    }

    match /producers/{producerId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /invitations/{invitationId} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        resource.data.invitedUserId == request.auth.uid ||
        resource.data.invitedEmail == request.auth.token.email ||
        hasProjectAccess(resource.data.projectId)
      );
      allow create: if isSignedIn() && (
        isAdmin() ||
        hasProjectAccess(request.resource.data.projectId) ||
        hasUserProjectPermission(request.resource.data.projectId, 'config') ||
        hasMemberPermission(request.resource.data.projectId, 'config') ||
        hasAccountingExtendedAccess(request.resource.data.projectId) ||
        isEPorPM(request.resource.data.projectId)
      );
      allow update: if isSignedIn() && (
        isAdmin() ||
        hasProjectAccess(resource.data.projectId) ||
        (
          // El invitado solo puede rechazarla o vincularla a su uid al
          // registrarse; aceptar la hace el servidor. No puede cambiarse
          // los permisos de la invitación.
          (resource.data.invitedUserId == request.auth.uid ||
           resource.data.invitedEmail == request.auth.token.email) &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["status", "respondedAt", "invitedUserId"]) &&
          request.resource.data.get("invitedUserId", null) in [null, request.auth.uid] &&
          (
            request.resource.data.status == resource.data.status ||
            (resource.data.status == "pending" && request.resource.data.status == "rejected")
          )
        )
      );
      allow delete: if isAdmin() || hasProjectAccess(resource.data.projectId);
    }

    match /departments/{departmentId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /forms/{formId} {
      // Quien tiene el enlace (el id es secreto) puede abrir su formulario,
      // pero nadie sin acceso al proyecto puede listar la colección.
      allow get: if true;
      allow list: if isSignedIn() && (
        isAdmin() ||
        hasTeamAccess(resource.data.projectId) ||
        hasProjectAccess(resource.data.projectId)
      );

      allow create: if isSignedIn() && (
        isAdmin() ||
        hasTeamAccess(request.resource.data.projectId) ||
        hasProjectAccess(request.resource.data.projectId)
      );

      allow update: if (
        // Envío desde el enlace público: solo la respuesta, una vez.
        resource.data.status == "pending" &&
        request.resource.data.status == "submitted" &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["status", "submittedAt", "responseData", "response"])
      ) || isAdmin() || (
        isSignedIn() && (
          hasTeamAccess(resource.data.projectId) ||
          hasProjectAccess(resource.data.projectId)
        )
      );

      allow delete: if isAdmin();
    }

    match /access/{code} {
      // El código es el secreto: se puede abrir por código, pero no listar.
      allow get: if true;
      allow list: if isSignedIn() && (isAdmin() || hasTeamAccess(resource.data.projectId));
      allow create: if isSignedIn() && (isAdmin() || hasTeamAccess(request.resource.data.projectId));
      allow update: if isSignedIn() &&
        (isAdmin() || hasTeamAccess(resource.data.projectId)) &&
        request.resource.data.projectId == resource.data.projectId;
      allow delete: if isSignedIn() && (isAdmin() || hasTeamAccess(resource.data.projectId));
    }

    match /supportChats/{userId} {
      allow read, update, delete: if isSignedIn() && (request.auth.uid == userId || isAdmin() || isSupportAgent());
      // Con el chat desactivado (meta/supportChat.enabled == false) nadie
      // puede abrir conversaciones nuevas.
      allow create: if isSignedIn() && (
        isAdmin() || isSupportAgent() ||
        (request.auth.uid == userId && isSupportChatEnabled())
      );

      match /messages/{msgId} {
        allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin() || isSupportAgent());
        allow create: if isSignedIn() && (request.auth.uid == userId || isAdmin() || isSupportAgent());
        allow update, delete: if isAdmin();
      }
    }

    // Los crea el servidor (/api/horario/*). El destinatario lo abre por
    // enlace (el id es secreto) y solo puede rellenar sus horas.
    // Conversaciones de soporte cerradas (las archiva /api/support/close).
    // Solo las ven admins y agentes; ningún usuario, sea del rol que sea.
    match /supportArchive/{archiveId} {
      allow read: if isAdmin() || isSupportAgent();
      allow write: if false;

      match /messages/{msgId} {
        allow read: if isAdmin() || isSupportAgent();
        allow write: if false;
      }
    }

    match /horarioForms/{formId} {
      allow get: if true;
      allow list: if isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin() || isHorarioSubmission();
      allow delete: if isAdmin();
    }

    // Códigos de /timesheet-review: los crea el servidor y la página los lee
    // a través de /api/horario/review.
    match /horarioAccess/{code} {
      allow get: if isAdmin();
      allow list: if isAdmin();
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /meta/{docId} {
      allow read: if true;
      // El resto de docs de meta tienen su propia regla más abajo. Ojo: las
      // reglas se suman, así que este comodín no puede permitir más de la
      // cuenta (antes dejaba a cualquiera editar featureFlags).
      // Solo el contador de tickets lo puede tocar cualquier usuario con sesión.
      allow write: if isSignedIn() && docId == "supportTicketCounter" &&
        request.resource.data.keys().hasOnly(["count"]);
    }

    // Activar/desactivar el chat de soporte para todo el mundo.
    match /meta/supportChat {
      allow read: if true;
      allow write: if isAdmin() || isSupportAgent();
    }

    match /meta/automatedMessages {
      allow read: if true;
      allow write: if isAdmin() || isSupportAgent();
    }

    match /meta/maintenance {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Flags de función (ver "Ver como el usuario" / admindashboard, pestaña
    // Sistema): generaliza lo que budgetingAccess ya hacía de forma binaria
    // y de un solo uso, para poder probar la próxima función nueva con un
    // grupo reducido de usuarios antes de abrirla a todos.
    match /meta/featureFlags {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Registro de cada ejecución del cron de Horario (ver app/api/cron/horario):
    // solo lo escribe el Admin SDK desde el propio cron (bypassa estas reglas),
    // aquí solo se controla quién puede leerlo desde admindashboard.
    match /meta/horarioCron/runs/{runId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Registro de auditoría: cada admin deja constancia de sus propios
    // cambios sensibles (rol, borrados, mantenimiento, difusión...) desde
    // admindashboard. Solo se puede crear (nunca editar ni borrar), y solo
    // como uno mismo — así nadie puede escribir una entrada a nombre de otro.
    match /adminAuditLog/{entryId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && request.resource.data.adminId == request.auth.uid;
      allow update, delete: if false;
    }

    match /guides/{guideId} {
      // Públicas si están publicadas (para el link que Soporte comparte);
      // admins y agentes de soporte ven también los borradores.
      allow read: if resource.data.published == true || isAdmin() || isSupportAgent();
      // Admins y agentes de soporte/ventas pueden crear y editar guías;
      // eliminarlas queda restringido a admins.
      allow create: if isAdmin() || isSupportAgent();
      allow delete: if isAdmin();
      // Cualquiera puede incrementar "views" en una guía publicada (contador
      // de visitas de la página pública); cualquier otro cambio requiere
      // admin o agente.
      allow update: if isAdmin() || isSupportAgent() || (
        resource.data.published == true &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views'])
      );
    }

  }
}
