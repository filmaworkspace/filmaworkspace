rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Sesión "Ver como" (un admin viendo la app como otro usuario, ver
    // /api/admin/impersonate): solo lectura. Como casi todas las reglas de
    // escritura pasan por isSignedIn(), basta con cortar aquí las escrituras.
    function isImpersonating() {
      return request.auth != null && request.auth.token.get('impersonatedBy', null) != null;
    }

    function isSignedIn() {
      return request.auth != null && (!isImpersonating() || request.method in ['get', 'list']);
    }

    // Proyecto congelado (o en la papelera): solo lectura salvo para admins.
    function projectOpen(projectId) {
      let path = /databases/$(database)/documents/projects/$(projectId);
      return request.method in ['get', 'list'] ||
             !exists(path) ||
             get(path).data.get('frozen', false) != true ||
             isAdmin();
    }

    function isAdmin() {
      return isSignedIn() && (
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin"
        ) ||
        request.auth.token.email == "admin@filmaworkspace.com"
      );
    }

    function isSupportAgent() {
      return isSignedIn() &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "support_agent";
    }

    function hasProjectAccess(projectId) {
      return isSignedIn() &&
             exists(/databases/$(database)/documents/userProjects/$(request.auth.uid)/projects/$(projectId));
    }

    function isProjectMember(projectId) {
      return isSignedIn() &&
             exists(/databases/$(database)/documents/projects/$(projectId)/members/$(request.auth.uid));
    }

    function hasUserProjectPermission(projectId, permission) {
      let docPath = /databases/$(database)/documents/userProjects/$(request.auth.uid)/projects/$(projectId);
      return isSignedIn() &&
             exists(docPath) &&
             get(docPath).data.permissions != null &&
             get(docPath).data.permissions[permission] == true;
    }

    function hasMemberPermission(projectId, permission) {
      let docPath = /databases/$(database)/documents/projects/$(projectId)/members/$(request.auth.uid);
      return isSignedIn() &&
             exists(docPath) &&
             get(docPath).data.permissions != null &&
             get(docPath).data.permissions[permission] == true;
    }


    function hasAccountingAccess(projectId) {
      let docPath = /databases/$(database)/documents/userProjects/$(request.auth.uid)/projects/$(projectId);
      return isSignedIn() &&
             exists(docPath) &&
             get(docPath).data.permissions != null &&
             get(docPath).data.permissions.accounting == true;
    }

    function hasAccountingExtendedAccess(projectId) {
      let docPath = /databases/$(database)/documents/projects/$(projectId)/members/$(request.auth.uid);
      return isSignedIn() &&
             exists(docPath) &&
             get(docPath).data.accountingAccessLevel == "accounting_extended";
    }

    function isEPorPM(projectId) {
      let docPath = /databases/$(database)/documents/projects/$(projectId)/members/$(request.auth.uid);
      return isSignedIn() &&
             exists(docPath) &&
             get(docPath).data.role in ["EP", "PM"];
    }

    function isApproverRole(projectId) {
      let docPath = /databases/$(database)/documents/projects/$(projectId)/members/$(request.auth.uid);
      return isSignedIn() &&
             exists(docPath) &&
             get(docPath).data.role in ["EP", "PM", "Controller", "PC"];
    }

    function hasTeamAccess(projectId) {
      return isSignedIn() && (
        hasUserProjectPermission(projectId, 'team') ||
        hasMemberPermission(projectId, 'team') ||
        isEPorPM(projectId) ||
        (
          exists(/databases/$(database)/documents/projects/$(projectId)/members/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/projects/$(projectId)/members/$(request.auth.uid)).data.role == "PC"
        )
      );
    }

    function getUserCompanyId() {
      let userDoc = /databases/$(database)/documents/users/$(request.auth.uid);
      return exists(userDoc) ? get(userDoc).data.get('companyId', null) : null;
    }

    function hasCompanyProjectAccess(projectId) {
      let companyId = getUserCompanyId();
      return companyId != null &&
             exists(/databases/$(database)/documents/companyProjects/$(companyId)/projects/$(projectId));
    }

    // Campos de users/{uid} que solo puede tocar un admin (o el servidor):
    // si el propio usuario pudiera escribirlos, podría hacerse admin, entrar
    // en una productora o darse acceso a Budgeting.
    function protectedUserFields() {
      return ["role", "companyId", "budgetingAccess", "supportSpecialty", "suspended", "isDemo", "demoExpiresAt", "demoProjectId", "demoLinkId"];
    }

    // Lo único que puede escribir quien rellena un horario desde su enlace.
    function isHorarioSubmission() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(["entrada", "salida", "comida", "observaciones", "submittedAt"]);
    }

    function isSupportChatEnabled() {
      let ref = /databases/$(database)/documents/meta/supportChat;
      return !exists(ref) || get(ref).data.get("enabled", true) != false;
    }

    function hasBudgetingAccess() {
      return isSignedIn() &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.budgetingAccess == true;
    }

    // ── Contabilidad: funciones de acceso ────────────────────────────────────
    function accMemberPath(projectId) {
      return /databases/$(database)/documents/projects/$(projectId)/members/$(request.auth.uid);
    }
    function accMember(projectId) {
      return get(accMemberPath(projectId)).data;
    }
    function isMemberOf(projectId) {
      return isSignedIn() && exists(accMemberPath(projectId));
    }
    // Tiene el módulo de contabilidad activado en el proyecto.
    function inAccounting(projectId) {
      return isSignedIn() && (hasAccountingAccess(projectId) || hasMemberPermission(projectId, 'accounting'));
    }
    function accLevel(projectId) {
      return isMemberOf(projectId) ? accMember(projectId).get('accountingAccessLevel', 'user') : 'none';
    }
    function accRole(projectId) {
      return isMemberOf(projectId) ? accMember(projectId).get('role', '') : '';
    }
    function isAccountant(projectId) {
      return inAccounting(projectId) && accLevel(projectId) in ['accounting', 'accounting_extended'];
    }
    function isAccExtended(projectId) {
      return inAccounting(projectId) && accLevel(projectId) == 'accounting_extended';
    }
    // Ve todas las POs, facturas y pagos del proyecto.
    function accSeesAll(projectId) {
      return isAdmin() || isEPorPM(projectId) || hasCompanyProjectAccess(projectId) || (
        inAccounting(projectId) && (
          accRole(projectId) in ['Controller', 'PC'] ||
          accLevel(projectId) in ['accounting', 'accounting_extended']
        )
      );
    }
    function canSeeBudgetFigures(projectId) {
      return isAdmin() || isEPorPM(projectId) || isAccExtended(projectId) || hasCompanyProjectAccess(projectId);
    }
    function canWriteBudget(projectId) {
      return isAdmin() || isEPorPM(projectId) || isAccExtended(projectId);
    }
    function isBoxUser(projectId) {
      return inAccounting(projectId) && (
        accLevel(projectId) in ['visitor', 'accounting', 'accounting_extended'] ||
        accMember(projectId).get('boxAccess', false) == true
      );
    }
    function canUseBox(projectId) {
      return isAdmin() || isEPorPM(projectId) || hasCompanyProjectAccess(projectId) ||
             isApproverRole(projectId) || isBoxUser(projectId);
    }
    function isDeptLead(projectId) {
      return isMemberOf(projectId) && accMember(projectId).get('position', '') in ['HOD', 'Coordinator'];
    }
    function myDepartment(projectId) {
      return accMember(projectId).get('department', '');
    }
    // PO/factura: la ve quien lo ve todo, quien la creó (o creó su PO), quien la aprueba y el
    // HOD/Coordinator de su departamento. Se escribe con resource.data.campo
    // (no .get) para que las consultas acotadas de la app se puedan validar.
    function canReadAccDoc(projectId) {
      return accSeesAll(projectId) || (
        inAccounting(projectId) && (
          resource.data.createdBy == request.auth.uid ||
          resource.data.poCreatedBy == request.auth.uid ||
          request.auth.uid in resource.data.approverIds ||
          (isDeptLead(projectId) && myDepartment(projectId) != '' && resource.data.department == myDepartment(projectId))
        )
      );
    }
    function canTouchAccDoc(projectId) {
      return inAccounting(projectId) && (
        resource.data.createdBy == request.auth.uid ||
        request.auth.uid in resource.data.get('approverIds', []) ||
        (isDeptLead(projectId) && myDepartment(projectId) != '' && resource.data.get('department', '') == myDepartment(projectId))
      );
    }
    // Quien no lo ve todo no puede cambiar el autor de un documento.
    function keepsOwner() {
      return request.resource.data.get('createdBy', null) == resource.data.get('createdBy', null);
    }
    // Contabilidad ampliada solo puede tocar el acceso a contabilidad de un
    // miembro (nivel, cajas y el permiso "accounting"), nunca su rol ni otros permisos.
    function onlyAccountingAccessChange() {
      return request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['permissions', 'accountingAccessLevel', 'boxAccess']) &&
             request.resource.data.get('permissions', {}).diff(resource.data.get('permissions', {}))
               .affectedKeys().hasOnly(['accounting']);
    }
    function counterUser(projectId, kind) {
      return (kind == 'crew' && (isAdmin() || hasTeamAccess(projectId))) ||
             (kind != 'crew' && (inAccounting(projectId) || accSeesAll(projectId)));
    }
    function isAccountingConfigDoc(configId) {
      return configId in ['project', 'company', 'approvals', 'permissions', 'cost', 'planCuentas'];
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      // Al registrarse, el usuario crea su propio doc siempre como "user" y
      // sin campos protegidos.
      allow create: if isAdmin() || (
        isSignedIn() && request.auth.uid == userId &&
        request.resource.data.get("role", "user") == "user" &&
        !request.resource.data.keys().hasAny(["companyId", "budgetingAccess", "supportSpecialty"])
      );
      // El propio usuario puede editar su perfil, pero no los campos protegidos.
      allow update: if isAdmin() || (
        isSignedIn() && request.auth.uid == userId &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(protectedUserFields())
      );
      allow delete: if isAdmin();

      match /projects/{projectId} {
        allow read: if isSignedIn() && request.auth.uid == userId;
        allow create, update: if isAdmin();
        allow delete: if isAdmin();
      }

      match /messages/{messageId} {
        allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
        allow create: if isAdmin();
        allow update: if isSignedIn() && request.auth.uid == userId;
        allow delete: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      }
    }

    // ── Enlaces para auditores ──
    // El auditor no entra aquí: su acceso pasa por el servidor (api/audit).
    match /auditLinks/{linkId} {
      allow read: if isSignedIn() && accSeesAll(resource.data.projectId);
      allow create: if isSignedIn() && accSeesAll(request.resource.data.projectId) &&
                       request.resource.data.createdBy == request.auth.uid &&
                       request.resource.data.revoked == false;
      allow update: if isSignedIn() && accSeesAll(resource.data.projectId) &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['files', 'ready', 'revoked', 'revokedAt', 'revokedByName']) &&
                       request.resource.data.projectId == resource.data.projectId;
      allow delete: if false;
      match /access/{accessId} {
        allow read: if isSignedIn() && accSeesAll(get(/databases/$(database)/documents/auditLinks/$(linkId)).data.projectId);
        allow write: if false;
      }
    }

    match /projects/{projectId} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        hasProjectAccess(projectId) ||
        isProjectMember(projectId) ||
        hasCompanyProjectAccess(projectId)
      );
      allow create: if projectOpen(projectId) && (isAdmin());
      allow update: if projectOpen(projectId) && (isAdmin() ||
                       hasUserProjectPermission(projectId, 'config') ||
                       hasMemberPermission(projectId, 'config'));
      allow delete: if projectOpen(projectId) && (isAdmin());

      match /members/{memberId} {
        allow read: if isSignedIn() && (
          isAdmin() ||
          hasProjectAccess(projectId) ||
          isProjectMember(projectId) ||
          hasCompanyProjectAccess(projectId)
        );
        allow create: if projectOpen(projectId) && (isAdmin() ||
                         hasUserProjectPermission(projectId, 'config') ||
                         hasMemberPermission(projectId, 'config') ||
                         hasUserProjectPermission(projectId, 'team') ||
                         hasMemberPermission(projectId, 'team'));
        // Aceptar una invitación lo hace el servidor (/api/accept-invitation):
        // un usuario no puede añadirse a sí mismo a un proyecto.
        allow update, delete: if projectOpen(projectId) && (isAdmin() ||
                                  hasUserProjectPermission(projectId, 'config') ||
                                  hasMemberPermission(projectId, 'config') ||
                                  hasUserProjectPermission(projectId, 'team') ||
                                  hasMemberPermission(projectId, 'team'));
        // Contabilidad ampliada gestiona solo el acceso a contabilidad.
        allow update: if projectOpen(projectId) && (isAccExtended(projectId) && onlyAccountingAccessChange());
      }

      match /departments/{departmentId} {
        allow read: if isSignedIn() && (
          isAdmin() ||
          hasProjectAccess(projectId) ||
          isProjectMember(projectId) ||
          hasCompanyProjectAccess(projectId)
        );
        allow write: if projectOpen(projectId) && (isAdmin() ||
                        hasUserProjectPermission(projectId, 'config') ||
                        hasMemberPermission(projectId, 'config'));
      }

      match /config/{configId} {
        allow read: if isSignedIn() && (
          isAdmin() ||
          hasProjectAccess(projectId) ||
          isProjectMember(projectId) ||
          hasCompanyProjectAccess(projectId)
        );
        allow write: if projectOpen(projectId) && (isAdmin() ||
                        isEPorPM(projectId) ||
                        (isAccExtended(projectId) && isAccountingConfigDoc(configId)) ||
                        hasUserProjectPermission(projectId, 'config'));

        // Subcolecciones (p. ej. company/bankAccounts: cuentas bancarias de la
        // productora): solo contabilidad y quien configura el proyecto.
        match /{subCollection}/{docId} {
          allow read: if isSignedIn() && (
            accSeesAll(projectId) ||
            isBoxUser(projectId) ||
            hasUserProjectPermission(projectId, 'config')
          );
          allow write: if projectOpen(projectId) && (isAdmin() ||
                          isEPorPM(projectId) ||
                          (isAccExtended(projectId) && isAccountingConfigDoc(configId)) ||
                          hasUserProjectPermission(projectId, 'config'));
        }
      }

      // ════════════════════════════════════════════════════════════════════
      // CONTABILIDAD
      // Quién ve qué (mismo criterio que la app, hooks/useAccountingPermissions):
      //  · accSeesAll: admin, productora, EP/PM, y con acceso a contabilidad
      //    Controller/PC o nivel "accounting"/"accounting_extended".
      //  · Resto con acceso a contabilidad: sus POs/facturas, las de su
      //    departamento si es HOD/Coordinator y las que tiene que aprobar.
      //  · Cifras de presupuesto (budgetLines): solo admin, EP/PM, contabilidad
      //    ampliada y productora.
      //  · BOX (tarjetas, transferencias, efectivo): nivel visitor/contabilidad/
      //    ampliado o boxAccess, EP/PM y roles aprobadores.
      // ════════════════════════════════════════════════════════════════════

      match /budgetLines/{subAccountId} {
        allow read: if canSeeBudgetFigures(projectId);
        allow write: if projectOpen(projectId) && (canWriteBudget(projectId));
      }

      // Numeración correlativa de POs, facturas (contabilidad) y crew (equipo).
      match /counters/{kind} {
        allow read: if counterUser(projectId, kind);
        allow create: if projectOpen(projectId) && (counterUser(projectId, kind) &&
                         kind in ['pos', 'invoices', 'crew'] &&
                         request.resource.data.keys().hasOnly(['last']) &&
                         request.resource.data.last is int);
        allow update: if projectOpen(projectId) && (counterUser(projectId, kind) &&
                         request.resource.data.keys().hasOnly(['last']) &&
                         request.resource.data.last is int &&
                         request.resource.data.last > resource.data.last);
      }

      match /accounts/{accountId} {
        // Código y descripción: los necesita todo el que codifica POs y facturas.
        allow read: if inAccounting(projectId) || accSeesAll(projectId);
        allow create, delete: if projectOpen(projectId) && (canWriteBudget(projectId));
        allow update: if projectOpen(projectId) && (canWriteBudget(projectId));

        match /subaccounts/{subId} {
          allow read: if inAccounting(projectId) || accSeesAll(projectId);
          // El presupuestado nunca se guarda aquí (va en budgetLines).
          allow create: if projectOpen(projectId) && (canWriteBudget(projectId) &&
                           !request.resource.data.keys().hasAny(['budgeted']));
          // Contabilidad ampliada / EP / PM: código, descripción, y quitar el
          // "budgeted" antiguo al trasladarlo. Nunca añadirlo ni cambiarlo.
          // Comprometido / realizado / caja los calcula y escribe solo el
          // servidor desde los documentos (lib/budgetLedger): nadie los toca aquí.
          allow update: if projectOpen(projectId) && (
                            canWriteBudget(projectId) &&
                            !request.resource.data.diff(resource.data).addedKeys().hasAny(['budgeted']) &&
                            !request.resource.data.diff(resource.data).changedKeys().hasAny(['budgeted']) &&
                            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['committed', 'actual', 'box'])
                          );
          allow delete: if projectOpen(projectId) && (canWriteBudget(projectId));
        }
      }

      match /suppliers/{supplierId} {
        allow read: if inAccounting(projectId) || accSeesAll(projectId);
        allow create, update: if projectOpen(projectId) && (accSeesAll(projectId) ||
                                 (inAccounting(projectId) && accLevel(projectId) != 'visitor'));
        allow delete: if projectOpen(projectId) && (isAdmin() || isEPorPM(projectId) || isAccExtended(projectId));
      }

      match /pos/{poId} {
        allow read: if canReadAccDoc(projectId);
        allow create: if projectOpen(projectId) && (accSeesAll(projectId) || (
                           inAccounting(projectId) && accLevel(projectId) != 'visitor' &&
                           request.resource.data.createdBy == request.auth.uid
                         ));
        allow update: if projectOpen(projectId) && (accSeesAll(projectId) || isApproverRole(projectId) ||
                         (canTouchAccDoc(projectId) && keepsOwner()));
        allow delete: if projectOpen(projectId) && (isAdmin() || isEPorPM(projectId) || (
                           inAccounting(projectId) &&
                           resource.data.createdBy == request.auth.uid &&
                           resource.data.status == 'draft'
                         ));
      }

      match /invoices/{invoiceId} {
        allow read: if canReadAccDoc(projectId);
        allow create: if projectOpen(projectId) && (accSeesAll(projectId) || (
                           inAccounting(projectId) && accLevel(projectId) != 'visitor' &&
                           request.resource.data.createdBy == request.auth.uid
                         ));
        allow update: if projectOpen(projectId) && (accSeesAll(projectId) || isApproverRole(projectId) ||
                         (canTouchAccDoc(projectId) && keepsOwner()));
        allow delete: if projectOpen(projectId) && (isAdmin() || isEPorPM(projectId));
      }

      match /payments/{paymentId} {
        allow read: if accSeesAll(projectId);
        allow write: if projectOpen(projectId) && (isAdmin() || isEPorPM(projectId) || isAccExtended(projectId));
      }

      match /paymentForecasts/{forecastId} {
        // El cajero (BOX) pide reposiciones de efectivo a tesorería desde aquí.
        allow read, create, update: if projectOpen(projectId) && (accSeesAll(projectId) || isBoxUser(projectId));
        allow delete: if projectOpen(projectId) && (isAdmin() || isEPorPM(projectId) || isAccExtended(projectId));
      }

      match /manualEntries/{entryId} {
        allow read: if isAdmin() || isAccountant(projectId) || hasCompanyProjectAccess(projectId);
        allow write: if projectOpen(projectId) && (isAdmin() || hasCompanyProjectAccess(projectId) || isAccExtended(projectId));
      }

      // ── BOX: tarjetas y transferencias ──
      match /cards/{boxId} {
        allow read: if canUseBox(projectId);
        allow create, update: if projectOpen(projectId) && (isAdmin() || isEPorPM(projectId) || isAccountant(projectId) || isBoxUser(projectId));
        allow delete: if projectOpen(projectId) && (isAdmin() || isEPorPM(projectId) || isAccExtended(projectId));
      }
      match /cardEnvelopes/{envelopeId} {
        // Caja lo gestiona; quien figura como aprobador del sobre (aunque no
        // sea de Caja) puede verlo y aprobarlo o rechazarlo, y nada más.
        allow read: if canUseBox(projectId) || (inAccounting(projectId) && request.auth.uid in resource.data.approverIds);
        allow create: if projectOpen(projectId) && (canUseBox(projectId));
        allow update: if projectOpen(projectId) && (canUseBox(projectId) || (
                         inAccounting(projectId) &&
                         request.auth.uid in resource.data.get('approverIds', []) &&
                         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['approvalSteps', 'currentApprovalStep', 'status', 'approvedAt', 'approvedBy', 'approvedByName', 'rejectedAt', 'rejectedBy', 'rejectedByName', 'rejectionReason', 'comments', 'infoRequested', 'infoRequestedBy', 'infoRequestedAt']) &&
                         request.resource.data.status in ['pending_approval', 'reviewing', 'open', 'draft']
                       ));
        allow delete: if projectOpen(projectId) && (isAdmin() || isEPorPM(projectId) || isAccExtended(projectId));
      }
      match /cardExpenses/{expenseId} {
        allow read, create, update: if projectOpen(projectId) && (canUseBox(projectId));
        allow delete: if projectOpen(projectId) && (isAdmin() || isEPorPM(projectId) || isAccExtended(projectId));
      }
      match /cardSuppliers/{supplierId} {
        allow read: if canUseBox(projectId);
        allow create, update: if projectOpen(projectId) && (isAdmin() || isEPorPM(projectId) || isAccountant(projectId) || isBoxUser(projectId));
        allow delete: if projectOpen(projectId) && (isAdmin() || isEPorPM(projectId) || isAccExtended(projectId));
      }
      match /transferEnvelopes/{envelopeId} {
        // Caja lo gestiona; quien figura como aprobador del sobre (aunque no
        // sea de Caja) puede verlo y aprobarlo o rechazarlo, y nada más.
        allow read: if canUseBox(projectId) || (inAccounting(projectId) && request.auth.uid in resource.data.approverIds);
        allow create: if projectOpen(projectId) && (canUseBox(projectId));
        allow update: if projectOpen(projectId) && (canUseBox(projectId) || (
                         inAccounting(projectId) &&
                         request.auth.uid in resource.data.get('approverIds', []) &&
                         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['approvalSteps', 'currentApprovalStep', 'status', 'approvedAt', 'approvedBy', 'approvedByName', 'rejectedAt', 'rejectedBy', 'rejectedByName', 'rejectionReason', 'comments', 'infoRequested', 'infoRequestedBy', 'infoRequestedAt']) &&
                         request.resource.data.status in ['pending_approval', 'reviewing', 'open', 'draft']
                       ));
        allow delete: if projectOpen(projectId) && (isAdmin() || isEPorPM(projectId) || isAccExtended(projectId));
      }
      match /transferExpenses/{expenseId} {
        allow read, create, update: if projectOpen(projectId) && (canUseBox(projectId));
        allow delete: if projectOpen(projectId) && (isAdmin() || isEPorPM(projectId) || isAccExtended(projectId));
      }

      // ── BOX: efectivo (Petty Cash) ──
      match /cashFloats/{floatId} {
        allow read, create, update: if projectOpen(projectId) && (isAdmin() || isEPorPM(projectId) || isAccountant(projectId) || isBoxUser(projectId));
        allow delete: if projectOpen(projectId) && (isAdmin() || isEPorPM(projectId) || isAccExtended(projectId));
      }

      match /cashMovements/{movementId} {
        allow read, create, update: if projectOpen(projectId) && (isAdmin() || isEPorPM(projectId) || isAccountant(projectId) || isBoxUser(projectId));
        // Un movimiento contabilizado ya no se puede borrar.
        allow delete: if projectOpen(projectId) && ((isAdmin() || isEPorPM(projectId) || isAccountant(projectId) || isBoxUser(projectId)) &&
                         resource.data.status != 'accounted');
      }

      // Firmas en la app del cajero (anticipos, entregas de tickets, liquidaciones).
      match /boxSignatures/{requestId} {
        allow read, create, update: if projectOpen(projectId) && (isAdmin() || isEPorPM(projectId) || isAccountant(projectId) || isBoxUser(projectId));
        allow delete: if projectOpen(projectId) && (isAdmin() || isEPorPM(projectId) || isAccExtended(projectId));
      }

      match /cashCounts/{countId} {
        allow read, create: if projectOpen(projectId) && (isAdmin() || isEPorPM(projectId) || isAccountant(projectId) || isBoxUser(projectId));
        allow update, delete: if projectOpen(projectId) && (isAdmin() || isEPorPM(projectId) || isAccExtended(projectId));
      }

      match /crew/{crewId} {
        allow read: if isSignedIn() && (
          isAdmin() ||
          hasTeamAccess(projectId) ||
          hasProjectAccess(projectId)
        );
        allow create, update: if projectOpen(projectId) && (isAdmin() ||
                                  hasTeamAccess(projectId));
        allow delete: if projectOpen(projectId) && (isAdmin() ||
                         hasTeamAccess(projectId));
      }

      match /teamConfig/{docId} {
        allow read: if isSignedIn() && (
          isAdmin() ||
          hasTeamAccess(projectId) ||
          hasProjectAccess(projectId)
        );
        allow write: if projectOpen(projectId) && (isAdmin() ||
                        hasTeamAccess(projectId) ||
                        isEPorPM(projectId));
      }

      match /payrollMonths/{monthId} {
        allow read: if isSignedIn() && (
                        isAdmin() ||
                        hasTeamAccess(projectId) ||
                        hasProjectAccess(projectId)
                      );
        // La página pública /access/[code] lee el mes por id. No se puede
        // listar sin sesión.
        allow get: if request.auth == null;

        allow write: if projectOpen(projectId) && ((isSignedIn() && (
                        isAdmin() ||
                        hasTeamAccess(projectId)
                      )) ||
                      (
                        request.auth == null &&
                        'accessCode' in request.resource.data &&
                        get(/databases/$(database)/documents/access/$(request.resource.data.accessCode)).data.active == true &&
                        get(/databases/$(database)/documents/access/$(request.resource.data.accessCode)).data.projectId == projectId
                      ));
      }

      // Nóminas: importes del mes y datos de nómina de cada persona. Solo
      // quien tiene acceso a Equipo (hay salarios).
      match /payrollRuns/{runId} {
        allow read: if isSignedIn() && (isAdmin() || hasTeamAccess(projectId));
        allow write: if projectOpen(projectId) && (isAdmin() || hasTeamAccess(projectId));
      }
      match /payrollPeople/{personId} {
        allow read: if isSignedIn() && (isAdmin() || hasTeamAccess(projectId));
        allow write: if projectOpen(projectId) && (isAdmin() || hasTeamAccess(projectId));
      }

      match /dietasForms/{formId} {
        allow read: if isSignedIn() && (
          isAdmin() ||
          hasTeamAccess(projectId) ||
          hasProjectAccess(projectId)
        );
        allow write: if projectOpen(projectId) && (isAdmin() ||
                        hasTeamAccess(projectId));
      }

      match /horario/{docId} {
        allow read: if isSignedIn() && (
          isAdmin() ||
          hasTeamAccess(projectId) ||
          hasProjectAccess(projectId)
        );
        allow write: if projectOpen(projectId) && (isAdmin() || hasTeamAccess(projectId));
      }

      match /horarioForms/{formId} {
        allow read: if isSignedIn() && (
          isAdmin() ||
          hasTeamAccess(projectId) ||
          hasProjectAccess(projectId)
        );
        allow create: if projectOpen(projectId) && (isAdmin() || hasTeamAccess(projectId));
        allow update: if projectOpen(projectId) && (isAdmin() || hasTeamAccess(projectId) || isHorarioSubmission());
        allow delete: if projectOpen(projectId) && (isAdmin());
      }

      match /horarioGroups/{groupId} {
        allow read: if isSignedIn() && (
          isAdmin() ||
          hasTeamAccess(projectId) ||
          hasProjectAccess(projectId)
        );
        allow write: if projectOpen(projectId) && (isAdmin() || hasTeamAccess(projectId));
      }

      match /logs/{logId} {
        allow read: if isAdmin();
        allow create: if projectOpen(projectId) && (isSignedIn());
        allow update, delete: if projectOpen(projectId) && (isAdmin());
      }
    }

    match /userProjects/{userId}/projects/{projectId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      // Quien gestiona el proyecto puede dar, cambiar y quitar accesos.
      allow write: if isSignedIn() && (
        isAdmin() ||
        hasUserProjectPermission(projectId, 'config') ||
        hasMemberPermission(projectId, 'config')
      );
      // Contabilidad ampliada solo puede dar o quitar acceso a contabilidad.
      allow update: if isSignedIn() && isAccExtended(projectId) && onlyAccountingAccessChange();
      // El propio usuario solo puede cambiar sus preferencias (archivar,
      // favorito, notificaciones), nunca sus permisos ni darse de alta.
      allow update: if isSignedIn() && request.auth.uid == userId &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["archived", "favorite"]);
    }

    match /companyProjects/{companyId}/projects/{projectId} {
      allow read: if isSignedIn() && (isAdmin() || getUserCompanyId() == companyId);
      allow write: if isAdmin();
    }

    // ── Budgeting: entorno independiente de proyecto, presupuestos de cero ──
    match /budgetingDrafts/{draftId} {
      allow read, update, delete: if isSignedIn() && (
        isAdmin() ||
        (hasBudgetingAccess() && resource.data.ownerUid == request.auth.uid)
      );
      allow create: if isSignedIn() && hasBudgetingAccess() &&
                       request.resource.data.ownerUid == request.auth.uid;

      match /accounts/{accountId} {
        allow read, write: if isSignedIn() && (
          isAdmin() ||
          (hasBudgetingAccess() &&
           get(/databases/$(database)/documents/budgetingDrafts/$(draftId)).data.ownerUid == request.auth.uid)
        );

        match /subchapters/{subchapterId} {
          allow read, write: if isSignedIn() && (
            isAdmin() ||
            (hasBudgetingAccess() &&
             get(/databases/$(database)/documents/budgetingDrafts/$(draftId)).data.ownerUid == request.auth.uid)
          );

          match /detailLines/{lineId} {
            allow read, write: if isSignedIn() && (
              isAdmin() ||
              (hasBudgetingAccess() &&
               get(/databases/$(database)/documents/budgetingDrafts/$(draftId)).data.ownerUid == request.auth.uid)
            );
          }
        }
      }

      match /snapshots/{snapshotId} {
        allow read, write: if isSignedIn() && (
          isAdmin() ||
          (hasBudgetingAccess() &&
           get(/databases/$(database)/documents/budgetingDrafts/$(draftId)).data.ownerUid == request.auth.uid)
        );
      }
    }

    match /userBudgetingDrafts/{userId}/drafts/{draftId} {
      allow read, write: if isSignedIn() && (request.auth.uid == userId || isAdmin());
    }

    match /userBudgetingTemplates/{userId}/templates/{templateId} {
      allow read, write: if isSignedIn() && (request.auth.uid == userId || isAdmin());
    }

    match /producers/{producerId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();

      // Notas internas de la cuenta (CRM ligero del admin).
      match /notes/{noteId} {
        allow read, write: if isAdmin();
      }
    }

    match /invitations/{invitationId} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        resource.data.invitedUserId == request.auth.uid ||
        resource.data.invitedEmail == request.auth.token.email ||
        hasProjectAccess(resource.data.projectId)
      );
      allow create: if isSignedIn() && (
        isAdmin() ||
        hasProjectAccess(request.resource.data.projectId) ||
        hasUserProjectPermission(request.resource.data.projectId, 'config') ||
        hasMemberPermission(request.resource.data.projectId, 'config') ||
        hasAccountingExtendedAccess(request.resource.data.projectId) ||
        isEPorPM(request.resource.data.projectId)
      );
      allow update: if isSignedIn() && (
        isAdmin() ||
        hasProjectAccess(resource.data.projectId) ||
        (
          // El invitado solo puede rechazarla o vincularla a su uid al
          // registrarse; aceptar la hace el servidor. No puede cambiarse
          // los permisos de la invitación.
          (resource.data.invitedUserId == request.auth.uid ||
           resource.data.invitedEmail == request.auth.token.email) &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["status", "respondedAt", "invitedUserId"]) &&
          request.resource.data.get("invitedUserId", null) in [null, request.auth.uid] &&
          (
            request.resource.data.status == resource.data.status ||
            (resource.data.status == "pending" && request.resource.data.status == "rejected")
          )
        )
      );
      allow delete: if isAdmin() || hasProjectAccess(resource.data.projectId);
    }

    match /departments/{departmentId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /forms/{formId} {
      // Quien tiene el enlace (el id es secreto) puede abrir su formulario,
      // pero nadie sin acceso al proyecto puede listar la colección.
      allow get: if true;
      allow list: if isSignedIn() && (
        isAdmin() ||
        hasTeamAccess(resource.data.projectId) ||
        hasProjectAccess(resource.data.projectId)
      );

      allow create: if isSignedIn() && (
        isAdmin() ||
        hasTeamAccess(request.resource.data.projectId) ||
        hasProjectAccess(request.resource.data.projectId)
      );

      allow update: if (
        // Envío desde el enlace público: solo la respuesta, una vez.
        resource.data.status == "pending" &&
        request.resource.data.status == "submitted" &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["status", "submittedAt", "responseData", "response"])
      ) || isAdmin() || (
        isSignedIn() && (
          hasTeamAccess(resource.data.projectId) ||
          hasProjectAccess(resource.data.projectId)
        )
      );

      allow delete: if isAdmin();
    }

    match /access/{code} {
      // El código es el secreto: se puede abrir por código, pero no listar.
      allow get: if true;
      allow list: if isSignedIn() && (isAdmin() || hasTeamAccess(resource.data.projectId));
      allow create: if isSignedIn() && (isAdmin() || hasTeamAccess(request.resource.data.projectId));
      allow update: if isSignedIn() &&
        (isAdmin() || hasTeamAccess(resource.data.projectId)) &&
        request.resource.data.projectId == resource.data.projectId;
      allow delete: if isSignedIn() && (isAdmin() || hasTeamAccess(resource.data.projectId));
    }

    match /supportChats/{userId} {
      allow read, update, delete: if isSignedIn() && (request.auth.uid == userId || isAdmin() || isSupportAgent());
      // Con el chat desactivado (meta/supportChat.enabled == false) nadie
      // puede abrir conversaciones nuevas.
      allow create: if isSignedIn() && (
        isAdmin() || isSupportAgent() ||
        (request.auth.uid == userId && isSupportChatEnabled())
      );

      match /messages/{msgId} {
        allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin() || isSupportAgent());
        allow create: if isSignedIn() && (request.auth.uid == userId || isAdmin() || isSupportAgent());
        allow update, delete: if isAdmin();
      }
    }

    // Los crea el servidor (/api/horario/*). El destinatario lo abre por
    // enlace (el id es secreto) y solo puede rellenar sus horas.
    // Conversaciones de soporte cerradas (las archiva /api/support/close).
    // Solo las ven admins y agentes; ningún usuario, sea del rol que sea.
    match /supportArchive/{archiveId} {
      allow read: if isAdmin() || isSupportAgent();
      allow write: if false;

      match /messages/{msgId} {
        allow read: if isAdmin() || isSupportAgent();
        allow write: if false;
      }
    }

    match /horarioForms/{formId} {
      allow get: if true;
      allow list: if isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin() || isHorarioSubmission();
      allow delete: if isAdmin();
    }

    // Códigos de /timesheet-review: los crea el servidor y la página los lee
    // a través de /api/horario/review.
    match /horarioAccess/{code} {
      allow get: if isAdmin();
      allow list: if isAdmin();
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /meta/{docId} {
      allow read: if true;
      // El resto de docs de meta tienen su propia regla más abajo. Ojo: las
      // reglas se suman, así que este comodín no puede permitir más de la
      // cuenta (antes dejaba a cualquiera editar featureFlags).
      // Solo el contador de tickets lo puede tocar cualquier usuario con sesión.
      allow write: if isSignedIn() && docId == "supportTicketCounter" &&
        request.resource.data.keys().hasOnly(["count"]);
    }

    // Activar/desactivar el chat de soporte para todo el mundo.
    match /meta/supportChat {
      allow read: if true;
      allow write: if isAdmin() || isSupportAgent();
    }

    match /meta/automatedMessages {
      allow read: if true;
      allow write: if isAdmin() || isSupportAgent();
    }

    match /meta/maintenance {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Flags de función (ver "Ver como el usuario" / admindashboard, pestaña
    // Sistema): generaliza lo que budgetingAccess ya hacía de forma binaria
    // y de un solo uso, para poder probar la próxima función nueva con un
    // grupo reducido de usuarios antes de abrirla a todos.
    match /meta/featureFlags {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Registro de cada ejecución del cron de Horario (ver app/api/cron/horario):
    // solo lo escribe el Admin SDK desde el propio cron (bypassa estas reglas),
    // aquí solo se controla quién puede leerlo desde admindashboard.
    match /meta/horarioCron/runs/{runId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Registro de auditoría: cada admin deja constancia de sus propios
    // cambios sensibles (rol, borrados, mantenimiento, difusión...) desde
    // admindashboard. Solo se puede crear (nunca editar ni borrar), y solo
    // como uno mismo — así nadie puede escribir una entrada a nombre de otro.
    match /adminAuditLog/{entryId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && request.resource.data.adminId == request.auth.uid;
      allow update, delete: if false;
    }

    match /guides/{guideId} {
      // Públicas si están publicadas (para el link que Soporte comparte);
      // admins y agentes de soporte ven también los borradores.
      allow read: if resource.data.published == true || isAdmin() || isSupportAgent();
      // Admins y agentes de soporte/ventas pueden crear y editar guías;
      // eliminarlas queda restringido a admins.
      allow create: if isAdmin() || isSupportAgent();
      allow delete: if isAdmin();
      // Cualquiera puede incrementar "views" en una guía publicada (contador
      // de visitas de la página pública); cualquier otro cambio requiere
      // admin o agente.
      allow update: if isAdmin() || isSupportAgent() || (
        resource.data.published == true &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views'])
      );
    }


    // ── Admin: registros que escribe el servidor (Admin SDK) ─────────────────
    match /emailLog/{entryId} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /securityEvents/{eventId} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /appErrors/{errorId} {
      allow read: if isAdmin();
      allow delete: if isAdmin();
      allow update: if isAdmin() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['resolved', 'resolvedAt', 'resolvedBy']);
      allow create: if false;
    }
    // Configuración privada del admin (resumen diario…). No va en meta/,
    // que es de lectura pública.
    match /adminConfig/{docId} {
      allow read, write: if isAdmin();
    }

    // ── Facturación de Filma a sus cuentas (admindashboard → Cuentas) ───────
    // Un borrador se edita libremente; una vez emitido (número asignado) solo
    // cambia su estado: cobrada, enviada o anulada con su rectificativa. Las
    // rectificativas se crean ya emitidas. Solo se borran borradores.
    match /billingInvoices/{invoiceId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && (
        request.resource.data.status == 'draft' ||
        (request.resource.data.status == 'issued' && request.resource.data.kind == 'rectifying' &&
         request.resource.data.get('rectifies', null) != null)
      );
      allow update: if isAdmin() && (
        resource.data.status == 'draft' ||
        (resource.data.status == 'issued' &&
         request.resource.data.status in ['issued', 'voided'] &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(
           ['status', 'paid', 'paidAt', 'sentAt', 'sentTo', 'voidReason', 'voidedAt', 'voidedBy', 'rectifiedBy', 'updatedAt'])) ||
        (resource.data.status == 'voided' &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sentAt', 'sentTo', 'updatedAt']))
      );
      allow delete: if isAdmin() && resource.data.status == 'draft';
    }

    // Filma Sign: solo el servidor escribe (enlaces con token cifrado);
    // los admins consultan las solicitudes y su auditoría.
    match /signRequests/{requestId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Datos fiscales de personas a las que se factura (Budgeting…): solo admins.
    match /billingClients/{userId} {
      allow read, write: if isAdmin();
    }

    // Presupuestos: igual, un borrador se edita; enviado solo cambia de estado.
    match /billingQuotes/{quoteId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && request.resource.data.status == 'draft';
      allow update: if isAdmin() && (
        resource.data.status == 'draft' ||
        (resource.data.status != 'draft' &&
         request.resource.data.status in ['sent', 'accepted', 'rejected'] &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(
           ['status', 'acceptedAt', 'rejectedAt', 'decisionNote', 'sentAt', 'sentTo', 'updatedAt']))
      );
      allow delete: if isAdmin() && resource.data.status == 'draft';
    }

    // Avisos dentro de la app y novedades (admindashboard → Avisos).
    match /announcements/{announcementId} {
      allow read: if isAdmin() || (isSignedIn() && (
        resource.data.audienceAll == true ||
        request.auth.uid in resource.data.audienceUserIds
      ));
      allow write: if isAdmin();
    }

  }
}
